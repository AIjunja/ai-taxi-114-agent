{
 "c1": {
  "text": "네, 114 택시 대신 불러드리기입니다. 어디서 타세요?",
  "voice": "ko-KR-SunHiNeural",
  "sec": 6.58
 },
 "u1": {
  "text": "여기 서울역이에요.",
  "voice": "ko-KR-InJoonNeural",
  "sec": 3.46
 },
 "u2": {
  "text": "세브란스 병원 가야 돼요.",
  "voice": "ko-KR-InJoonNeural",
  "sec": 3.89
 },
 "c2": {
  "text": "신촌 세브란스요, 강남 세브란스요?",
  "voice": "ko-KR-SunHiNeural",
  "sec": 4.2
 },
 "u3": {
  "text": "신촌이요.",
  "voice": "ko-KR-InJoonNeural",
  "sec": 2.52
 },
 "c3": {
  "text": "서울역에서 신촌세브란스병원으로 택시 불러드릴까요?",
  "voice": "ko-KR-SunHiNeural",
  "sec": 5.04
 },
 "u4": {
  "text": "네, 불러 주세요.",
  "voice": "ko-KR-InJoonNeural",
  "sec": 3.96
 },
 "c4": {
  "text": "네, 지금 바로 불러드릴게요. 잠시만 기다려 주세요.",
  "voice": "ko-KR-SunHiNeural",
  "sec": 6.38
 },
 "r_ok": {
  "text": "택시가 잡혔어요.",
  "voice": "ko-KR-SunHiNeural",
  "sec": 2.54
 },
 "r_plate": {
  "text": "차 번호는",
  "voice": "ko-KR-SunHiNeural",
  "sec": 2.11
 },
 "r_end": {
  "text": "이에요.",
  "voice": "ko-KR-SunHiNeural",
  "sec": 1.87
 },
 "r_none": {
  "text": "지금 근처에 빈 택시가 없어요. 몇 분 뒤에 다시 불러드릴까요?",
  "voice": "ko-KR-SunHiNeural",
  "sec": 6.7
 },
 "u5": {
  "text": "고마워요.",
  "voice": "ko-KR-InJoonNeural",
  "sec": 2.74
 },
