{
  "rewrites": [
    {
      "source": "/((?!api/|evidence/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), geolocation=(), camera=()"
        }
      ]
    }
  ],
  "functions": {
    "api/worker.ts": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/dispatch.ts": {
      "maxDuration": 10
    }
  }
}